# HealthFlow AI configuration.
# Development and demo mode run with none of these set. A production server refuses to start
# until the "Required in production" values are present (see lib/config.ts).
# Never commit real values.

# --- Required in production ------------------------------------------------
# HMAC key for session cookies. At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=
# AES-256-GCM key for the data store, uploaded documents and MFA secrets: openssl rand -base64 32
# Losing it makes stored data unreadable. Keep it in a secrets manager, never next to the data.
HF_DATA_KEY=
# Public https origin, used in emailed links.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123
# Transactional email for password resets and invitations (Resend). Emails contain links only, no PHI.
RESEND_API_KEY=
EMAIL_FROM=

# --- Runtime behavior -------------------------------------------------------
# true: seed the synthetic clinic, show demo accounts and on-screen reset links. Defaults to true
# in development and false in production. Not allowed in production.
HF_DEMO_MODE=
# Directory for store.json and uploads. Put it on an encrypted, backed-up persistent volume.
HF_DATA_DIR=
# Default inactivity sign-out for new organizations (5-60 minutes). Admins can change it per org.
SESSION_IDLE_MINUTES=15
# Set true on HTTPS. Defaults to true in production.
COOKIE_SECURE=

# --- Single sign-on (platform apps) -------------------------------------------
# One multi-tenant app registration per provider, owned by whoever runs HealthFlow.
# Redirect URI to register: {NEXT_PUBLIC_APP_URL}/api/auth/sso/callback
# Customers using Okta, Ping, OneLogin etc. enter their own issuer and client in Settings > Security.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Integrations -------------------------------------------------------------
# Clearinghouse API keys are entered per organization in Integrations (stored encrypted).
# Optional override for the Stedi eligibility endpoint (sandbox testing).
STEDI_BASE_URL=

# --- AI --------------------------------------------------------------------
# mock | anthropic | openai
AI_PROVIDER=mock
# Remote models stay disabled until this is true. Set it only after a BAA with that vendor is signed.
AI_BAA_CONFIRMED=
AI_TIMEOUT_MS=30000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Reserved for the Postgres adapter (not yet used at runtime) -----------
DATA_PROVIDER=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Billing (checkout not live) -------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# --- Never set in production -----------------------------------------------
# Skips the production config guard. For local smoke tests with synthetic data only.
HF_SKIP_CONFIG_CHECK=
